[page mode=document title="Kitchen Sink"]
  [heading level=1 fg=cyan]AML Kitchen Sink[/heading]
  [text dim]Every element type demonstrated.[/text]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Text Styles[/heading]
  [text bold]Bold text[/text]
  [text italic]Italic text[/text]
  [text underline]Underlined text[/text]
  [text strikethrough]Strikethrough text[/text]
  [text dim]Dim text[/text]
  [text fg=red]Red text[/text]
  [text fg=green bg=black]Green on black[/text]
  [text fg=#ff6600]Custom hex color (orange)[/text]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Box Styles[/heading]
  [row gap=2]
    [col w=20]
      [box w=18 h=5 border=single fg=white title="Single"]
        [text]Content[/text]
      [/box]
    [/col]
    [col w=20]
      [box w=18 h=5 border=double fg=cyan title="Double"]
        [text]Content[/text]
      [/box]
    [/col]
    [col w=20]
      [box w=18 h=5 border=rounded fg=green title="Rounded"]
        [text]Content[/text]
      [/box]
    [/col]
  [/row]
  [spacer lines=1 /]
  [row gap=2]
    [col w=20]
      [box w=18 h=5 border=heavy fg=red title="Heavy"]
        [text]Content[/text]
      [/box]
    [/col]
    [col w=20]
      [box w=18 h=5 border=ascii fg=yellow title="ASCII"]
        [text]Content[/text]
      [/box]
    [/col]
    [col w=20]
      [box w=18 h=5 border=none]
        [text]No border[/text]
      [/box]
    [/col]
  [/row]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Horizontal Rules[/heading]
  [text dim]Single:[/text]
  [hr style=single /]
  [text dim]Double:[/text]
  [hr style=double /]
  [text dim]Heavy:[/text]
  [hr style=heavy /]
  [text dim]Dash:[/text]
  [hr style=dash /]
  [text dim]Dot:[/text]
  [hr style=dot /]
  [text dim]ASCII:[/text]
  [hr style=ascii /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Lists[/heading]
  [text fg=white]Bullet list:[/text]
  [list style=bullet]
    [item][text]First item[/text][/item]
    [item][text]Second item[/text][/item]
    [item][text]Third item[/text][/item]
  [/list]
  [spacer lines=1 /]
  [text fg=white]Numbered list:[/text]
  [list style=number]
    [item][text]Step one[/text][/item]
    [item][text]Step two[/text][/item]
    [item][text]Step three[/text][/item]
  [/list]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Table[/heading]
  [table border=single]
    [thead]
      [tr][th]Name[/th][th]Role[/th][th]Status[/th][/tr]
    [/thead]
    [tbody]
      [tr][td]Alice[/td][td]Admin[/td][td fg=green]Online[/td][/tr]
      [tr][td]Bob[/td][td]Moderator[/td][td fg=yellow]Away[/td][/tr]
      [tr][td]Charlie[/td][td]User[/td][td fg=red]Offline[/td][/tr]
    [/tbody]
  [/table]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Interactive Elements[/heading]
  [form action="/demo"]
    [input name="username" placeholder="Enter username" /]
    [input name="password" placeholder="Enter password" password /]
    [select name="role" label="Select role:"]
      [option value="user"]User[/option]
      [option value="admin" selected]Admin[/option]
    [/select]
    [button action=submit]Submit[/button]
  [/form]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Links[/heading]
  [link href="atp://neon.city/" transition="dissolve"]
    [text fg=bright-cyan]Visit DUSTNET[/text]
  [/link]
  [link href="atp://dark.zone/" transition="matrix"]
    [text fg=bright-green]Enter the Dark Zone[/text]
  [/link]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Preformatted / Art[/heading]
  [pre fg=cyan]
╔══════════════════════════════════╗
║  ░░▒▒▓▓██  Dustnet LOGO  ██▓▓▒▒░░  ║
║                                  ║
║    Terminal-Native Social Web    ║
╚══════════════════════════════════╝
  [/pre]
  [spacer lines=1 /]

  [hr style=heavy fg=cyan /]
  [text align=center dim]End of kitchen sink demo[/text]
[/page]
