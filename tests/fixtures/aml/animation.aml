[page mode=document title="Animation Demo"]

  [heading level=1 fg=bright-cyan]Animation Demo[/heading]
  [text dim]Frame-based animations with different loop modes.[/text]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Spinner (infinite loop, 4fps)[/heading]
  [animate id="spinner" fps=4 loop=true]
    [frame][pre fg=cyan]|  [/pre][/frame]
    [frame][pre fg=cyan]/  [/pre][/frame]
    [frame][pre fg=cyan]-  [/pre][/frame]
    [frame][pre fg=cyan]\  [/pre][/frame]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Loading dots (infinite, 5fps)[/heading]
  [animate id="dots" fps=5 loop=true]
    [frame][pre fg=green].  [/pre][/frame]
    [frame][pre fg=green].. [/pre][/frame]
    [frame][pre fg=green]...[/pre][/frame]
    [frame][pre fg=green]   [/pre][/frame]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Progress bar (plays once, 4fps)[/heading]
  [animate id="progress" fps=4 loop=false]
    [frame][pre][[          ]] 0%  [/pre][/frame]
    [frame][pre][[##        ]] 20% [/pre][/frame]
    [frame][pre][[####      ]] 40% [/pre][/frame]
    [frame][pre][[######    ]] 60% [/pre][/frame]
    [frame][pre][[########  ]] 80% [/pre][/frame]
    [frame][pre][[##########]] 100%[/pre][/frame]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Bounce (ping-pong, 8fps)[/heading]
  [animate id="bounce" fps=8 loop=bounce]
    [frame][pre fg=magenta]>         [/pre][/frame]
    [frame][pre fg=magenta] >        [/pre][/frame]
    [frame][pre fg=magenta]  >       [/pre][/frame]
    [frame][pre fg=magenta]   >      [/pre][/frame]
    [frame][pre fg=magenta]    >     [/pre][/frame]
    [frame][pre fg=magenta]     >    [/pre][/frame]
    [frame][pre fg=magenta]      >   [/pre][/frame]
    [frame][pre fg=magenta]       >  [/pre][/frame]
    [frame][pre fg=magenta]        > [/pre][/frame]
    [frame][pre fg=magenta]         >[/pre][/frame]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Blinking status (3fps, infinite)[/heading]
  [animate id="blink" fps=3 loop=true]
    [frame][pre fg=green]* ONLINE *[/pre][/frame]
    [frame][pre fg=white]  ONLINE  [/pre][/frame]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Typewriter (WASM, 15fps)[/heading]
  [animate id="typewriter" src="/effects/typewriter.wasm" fps=15]
    [text fg=green]Welcome to the terminal. You have entered the network...[/text]
  [/animate]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Typewriter with delay (WASM, 12fps, 2s delay)[/heading]
  [animate id="typewriter-delayed" src="/effects/typewriter.wasm" fps=12 delay=2s]
    [text fg=cyan]This message appears after a short delay.[/text]
  [/animate]
  [spacer lines=1 /]

  [hr style=heavy fg=cyan /]
  [text align=center dim]Scroll to see viewport-aware pausing. Press q to quit.[/text]
[/page]
