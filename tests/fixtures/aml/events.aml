[page mode=document title="Event Binding Demos"]

  [heading level=1 fg=bright-cyan]Event Binding Demos[/heading]
  [text dim]Declarative choreography with [[on]] — animations and panels driven by events.[/text]
  [spacer lines=1 /]

  [hr style=heavy fg=cyan /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]1. Page-Load Sequence[/heading]
  [text dim]Three animations fire in sequence when the page loads, each with a staggered delay.[/text]
  [spacer lines=1 /]

  [animate id="seq1" fps=6 loop=false autoplay=false]
    [frame][pre fg=green]> Initializing.[/pre][/frame]
    [frame][pre fg=green]> Initializing..[/pre][/frame]
    [frame][pre fg=green]> Initializing...[/pre][/frame]
    [frame][pre fg=bright-green]> Systems online.[/pre][/frame]
  [/animate]

  [animate id="seq2" fps=6 loop=false autoplay=false]
    [frame][pre fg=cyan]> Scanning.[/pre][/frame]
    [frame][pre fg=cyan]> Scanning..[/pre][/frame]
    [frame][pre fg=cyan]> Scanning...[/pre][/frame]
    [frame][pre fg=bright-cyan]> Network found.[/pre][/frame]
  [/animate]

  [animate id="seq3" fps=6 loop=false autoplay=false]
    [frame][pre fg=yellow]> Connecting.[/pre][/frame]
    [frame][pre fg=yellow]> Connecting..[/pre][/frame]
    [frame][pre fg=yellow]> Connecting...[/pre][/frame]
    [frame][pre fg=bright-yellow]> CONNECTED.[/pre][/frame]
  [/animate]

  [on event="page-load" do="animate" target="seq1" /]
  [on event="page-load" do="animate" target="seq2" delay="700ms" /]
  [on event="page-load" do="animate" target="seq3" delay="1400ms" /]

  [spacer lines=1 /]
  [hr style=dash /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]2. Animation Chaining[/heading]
  [text dim]Each animation triggers the next via animation-end events — a cascading intro.[/text]
  [spacer lines=1 /]

  [animate id="chain1" fps=8 loop=false autoplay=false]
    [frame][pre]        [/pre][/frame]
    [frame][pre fg=red]█       [/pre][/frame]
    [frame][pre fg=red]██      [/pre][/frame]
    [frame][pre fg=red]███     [/pre][/frame]
    [frame][pre fg=red]████    [/pre][/frame]
    [frame][pre fg=bright-red]█████   [/pre][/frame]
  [/animate]

  [animate id="chain2" fps=8 loop=false autoplay=false]
    [frame][pre]        [/pre][/frame]
    [frame][pre fg=green]█       [/pre][/frame]
    [frame][pre fg=green]██      [/pre][/frame]
    [frame][pre fg=green]███     [/pre][/frame]
    [frame][pre fg=green]████    [/pre][/frame]
    [frame][pre fg=bright-green]█████   [/pre][/frame]
  [/animate]

  [animate id="chain3" fps=8 loop=false autoplay=false]
    [frame][pre]        [/pre][/frame]
    [frame][pre fg=blue]█       [/pre][/frame]
    [frame][pre fg=blue]██      [/pre][/frame]
    [frame][pre fg=blue]███     [/pre][/frame]
    [frame][pre fg=blue]████    [/pre][/frame]
    [frame][pre fg=bright-blue]█████   [/pre][/frame]
  [/animate]

  [on event="page-load" do="animate" target="chain1" /]
  [on event="animation-end" source="chain1" do="animate" target="chain2" /]
  [on event="animation-end" source="chain2" do="animate" target="chain3" /]

  [spacer lines=1 /]
  [hr style=dash /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]3. Focus-Driven Preview[/heading]
  [text dim]Tab between links to change the preview panel. Focus fires set actions.[/text]
  [spacer lines=1 /]

  [row gap=2]
    [col w=20]
      [link id="f-alpha" href="/alpha"][text]> Alpha[/text][/link]
      [link id="f-beta" href="/beta"][text]> Beta[/text][/link]
      [link id="f-gamma" href="/gamma"][text]> Gamma[/text][/link]
    [/col]
    [col]
      [panel id="preview" state="none"]
        [state name="none"]
          [box border=single fg=white w=40 h=5]
            [text dim italic]Tab to a link to see its preview.[/text]
          [/box]
        [/state]
        [state name="alpha" transition="fade" duration="150ms"]
          [box border=single fg=bright-green w=40 h=5 title="Alpha"]
            [text fg=green]First protocol variant.[/text]
            [text fg=green]Low latency, high throughput.[/text]
          [/box]
        [/state]
        [state name="beta" transition="fade" duration="150ms"]
          [box border=single fg=bright-cyan w=40 h=5 title="Beta"]
            [text fg=cyan]Experimental branch.[/text]
            [text fg=cyan]Extended encryption suite.[/text]
          [/box]
        [/state]
        [state name="gamma" transition="fade" duration="150ms"]
          [box border=single fg=bright-yellow w=40 h=5 title="Gamma"]
            [text fg=yellow]Research variant.[/text]
            [text fg=yellow]Mesh topology support.[/text]
          [/box]
        [/state]
      [/panel]
    [/col]
  [/row]

  [on event="focus" source="f-alpha" do="set" target="preview" to="alpha" /]
  [on event="focus" source="f-beta" do="set" target="preview" to="beta" /]
  [on event="focus" source="f-gamma" do="set" target="preview" to="gamma" /]

  [spacer lines=1 /]
  [hr style=dash /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]4. State-Change Triggers Animation[/heading]
  [text dim]Toggling a panel fires a state-change event that starts an indicator animation.[/text]
  [spacer lines=1 /]

  [row gap=2]
    [col w=30]
      [panel id="reactor" state="offline"]
        [state name="offline"]
          [box border=heavy fg=red w=28 h=4]
            [text bold fg=red align=center]REACTOR OFFLINE[/text]
            [text dim align=center]All systems idle[/text]
          [/box]
        [/state]
        [state name="online" transition="fade" duration="200ms"]
          [box border=heavy fg=green w=28 h=4]
            [text bold fg=bright-green align=center]REACTOR ONLINE[/text]
            [text fg=green align=center]All systems nominal[/text]
          [/box]
        [/state]
      [/panel]
    [/col]
    [col]
      [animate id="pulse" fps=3 loop=true autoplay=false]
        [frame][pre fg=green]  *  [/pre][/frame]
        [frame][pre fg=bright-green] *** [/pre][/frame]
        [frame][pre fg=green]*****[/pre][/frame]
        [frame][pre fg=bright-green] *** [/pre][/frame]
      [/animate]
    [/col]
  [/row]

  [button action="toggle" target="reactor" states="offline,online" key="r"]
    Toggle Reactor
  [/button]

  [on event="state-change" source="reactor" do="animate" target="pulse" /]

  [spacer lines=1 /]
  [hr style=dash /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]5. Delayed Actions[/heading]
  [text dim]A single page-load event triggers five animations with staggered delays — cascade effect.[/text]
  [spacer lines=1 /]

  [animate id="bar1" fps=1 loop=false autoplay=false]
    [frame][pre fg=red]█████████████████████████████████████████[/pre][/frame]
  [/animate]
  [animate id="bar2" fps=1 loop=false autoplay=false]
    [frame][pre fg=yellow]█████████████████████████████████████████[/pre][/frame]
  [/animate]
  [animate id="bar3" fps=1 loop=false autoplay=false]
    [frame][pre fg=green]█████████████████████████████████████████[/pre][/frame]
  [/animate]
  [animate id="bar4" fps=1 loop=false autoplay=false]
    [frame][pre fg=cyan]█████████████████████████████████████████[/pre][/frame]
  [/animate]
  [animate id="bar5" fps=1 loop=false autoplay=false]
    [frame][pre fg=blue]█████████████████████████████████████████[/pre][/frame]
  [/animate]

  [on event="page-load" do="animate" target="bar1" /]
  [on event="page-load" do="animate" target="bar2" delay="150ms" /]
  [on event="page-load" do="animate" target="bar3" delay="300ms" /]
  [on event="page-load" do="animate" target="bar4" delay="450ms" /]
  [on event="page-load" do="animate" target="bar5" delay="600ms" /]

  [spacer lines=1 /]
  [hr style=heavy fg=cyan /]
  [text align=center dim]Press q to quit. Tab to navigate focusable elements.[/text]

[/page]
