[page mode=document title="Lists and tables"]

  [heading level=1 fg=bright-cyan]Lists and tables[/heading]
  [link href="/"][text dim]< back to index[/text][/link]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Bullet list[/heading]
  [list style=bullet]
    [item][text]Sites serve declarative markup, not code[/text][/item]
    [item][text]The client owns layout and input[/text][/item]
    [item][text]Animation runs in a sandbox with no network[/text][/item]
  [/list]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Numbered list[/heading]
  [list style=number]
    [item][text]Connect and negotiate capabilities[/text][/item]
    [item][text]Fetch a page[/text][/item]
    [item][text]Parse, lay out, and render it[/text][/item]
  [/list]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Table[/heading]
  [table border=single]
    [thead]
      [tr][th]Element[/th][th]Purpose[/th][th]Nests[/th][/tr]
    [/thead]
    [tbody]
      [tr][td]box[/td][td]Bordered container[/td][td fg=green]yes[/td][/tr]
      [tr][td]row[/td][td]Horizontal group[/td][td fg=green]yes[/td][/tr]
      [tr][td]text[/td][td]Styled run[/td][td fg=green]yes[/td][/tr]
      [tr][td]hr[/td][td]Rule[/td][td fg=red]no[/td][/tr]
    [/tbody]
  [/table]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Table without borders[/heading]
  [table border=none]
    [tbody]
      [tr][td dim]scanner[/td][td]tokenises bytes[/td][/tr]
      [tr][td dim]parser[/td][td]builds the document[/td][/tr]
      [tr][td dim]layout[/td][td]places elements in cells[/td][/tr]
    [/tbody]
  [/table]
[/page]
