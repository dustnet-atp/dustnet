[page mode=document title="Layout"]

  [heading level=1 fg=bright-cyan]Boxes, rows and columns[/heading]
  [link href="/"][text dim]< back to index[/text][/link]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Border styles[/heading]
  [row gap=2]
    [col w=20][box w=18 h=4 border=single fg=white title="Single"][text]Content[/text][/box][/col]
    [col w=20][box w=18 h=4 border=double fg=cyan title="Double"][text]Content[/text][/box][/col]
    [col w=20][box w=18 h=4 border=rounded fg=green title="Rounded"][text]Content[/text][/box][/col]
  [/row]
  [spacer lines=1 /]
  [row gap=2]
    [col w=20][box w=18 h=4 border=heavy fg=red title="Heavy"][text]Content[/text][/box][/col]
    [col w=20][box w=18 h=4 border=ascii fg=yellow title="ASCII"][text]Content[/text][/box][/col]
    [col w=20][box w=18 h=4 border=none][text]No border[/text][/box][/col]
  [/row]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Nested containers[/heading]
  [box border=single fg=white title="Outer"]
    [row gap=1]
      [col w=24]
        [box border=rounded fg=cyan title="Left"]
          [text]A column keeps its own width and wraps inside it.[/text]
        [/box]
      [/col]
      [col w=24]
        [box border=rounded fg=magenta title="Right"]
          [text]Siblings lay out side by side until the row runs out of room.[/text]
        [/box]
      [/col]
    [/row]
  [/box]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Absolute placement[/heading]
  [text dim]Boxes with x/y coordinates are positioned rather than flowed.[/text]
  [box x=4 y=2 w=22 h=5 border=double fg=bright-blue title="Placed"]
    [text]x=4 y=2[/text]
  [/box]
  [spacer lines=6 /]
[/page]
