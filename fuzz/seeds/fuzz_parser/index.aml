[page mode=document title="Neon City BBS"]
  [header]
    [pre fg=cyan]
 ╔═══════════════════════════════════════════════════════╗
 ║  ░▒▓█  N E O N   C I T Y   B B S  █▓▒░              ║
 ║        est. 1985  ·  terminal-native  ·  ATP          ║
 ╚═══════════════════════════════════════════════════════╝
    [/pre]
  [/header]

  [body]
    [text dim]Welcome, traveler. You've connected to Neon City.[/text]
    [spacer lines=1 /]

    [box border=rounded fg=cyan w=55 title="Directory"]
      [list style=bullet]
        [item]
          [link href="/board" transition="slide-left" transition_duration_ms=250]
            [text fg=bright-cyan bold]Message Board[/text]
          [/link]
          [text dim] — read the latest posts[/text]
        [/item]
        [item]
          [link href="/gallery" transition="dissolve" transition_duration_ms=300]
            [text fg=bright-magenta bold]Art Gallery[/text]
          [/link]
          [text dim] — ANSI art collection[/text]
        [/item]
        [item]
          [link href="/about" transition="fade" transition_duration_ms=150]
            [text fg=bright-yellow bold]About This Site[/text]
          [/link]
          [text dim] — how it works[/text]
        [/item]
        [item]
          [link href="/settings" transition="slide-up" transition_duration_ms=300]
            [text fg=bright-green bold]Settings[/text]
          [/link]
          [text dim] — toggle options[/text]
        [/item]
        [item]
          [link href="/live" transition="fade" transition_duration_ms=150]
            [text fg=bright-red bold]Live Demo[/text]
          [/link]
          [text dim] — real-time content updates[/text]
        [/item]
      [/list]
    [/box]

    [spacer lines=1 /]

    [box border=single fg=yellow w=55 title="System Status"]
      [row]
        [col w=27]
          [text fg=green]Server:  [text bold fg=bright-green]ONLINE[/text][/text]
          [text fg=white]Uptime:  42 days[/text]
        [/col]
        [col w=27]
          [text fg=white]Users:   3 online[/text]
          [text fg=white]Posts:   1,247[/text]
        [/col]
      [/row]
    [/box]

    [spacer lines=1 /]

    [animate id="spinner" fps=4 loop=true]
      [frame][pre fg=white]  Listening on port 1985... |[/pre][/frame]
      [frame][pre fg=white]  Listening on port 1985... /[/pre][/frame]
      [frame][pre fg=white]  Listening on port 1985... -[/pre][/frame]
      [frame][pre fg=white]  Listening on port 1985... \[/pre][/frame]
    [/animate]
  [/body]

  [footer]
    [hr style=heavy fg=cyan /]
    [text dim align=center]Tab to navigate · Enter to follow link · q to quit[/text]
  [/footer]
[/page]
