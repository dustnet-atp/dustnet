[page mode=document title="Component Demos"]

  [def name="card" attrs="title,border-color=white" slots="body"]
    [box border=rounded fg=$border-color title=$title]
      [slot name="body" /]
    [/box]
  [/def]

  [def name="badge" attrs="color=white,label"]
    [box w=20 h=3 border=single fg=$color]
      [text bold fg=$color align=center]$label[/text]
    [/box]
  [/def]

  [def name="section" attrs="title" slots="content,footer"]
    [heading level=2 fg=cyan]$title[/heading]
    [slot name="content" /]
    [slot name="footer"]
      [hr style=dash fg=cyan /]
    [/slot]
    [spacer lines=1 /]
  [/def]

  [def name="post" attrs="author,time,likes=0,replies=0,reposts=0" slots="content"]
    [box border=single fg=white]
      [text bold]$author[/text]
      [text dim]  $time[/text]
      [hr style=dot /]
      [slot name="content" /]
      [hr style=dot /]
      [text dim]$likes likes  $replies replies  $reposts reposts[/text]
    [/box]
    [spacer lines=1 /]
  [/def]

  [def name="tag" attrs="color,label"]
    [text fg=$color bold][[$label]][/text]
  [/def]

  [heading level=1 fg=bright-cyan]Component Demos[/heading]
  [text dim]Reusable [[def]] components with attribute substitution and slots.[/text]
  [spacer lines=1 /]

  [section title="Badges"]
    [row gap=2]
      [col w=20][badge color=green label="ONLINE" /][/col]
      [col w=20][badge color=red label="OFFLINE" /][/col]
      [col w=20][badge color=yellow label="BUSY" /][/col]
    [/row]
  [/section]

  [section title="Cards with Slots"]
    [card title="Welcome" border-color=cyan]
      [text]Hello, visitor.[/text]
      [text dim]Enjoy your stay on Dustnet.[/text]
    [/card]
    [spacer lines=1 /]
    [card title="News" border-color=yellow]
      [text]Dustnet v0.2.0 released![/text]
      [text]Now with components and panels.[/text]
    [/card]
  [/section]

  [section title="Post Component"]
    [post author="@alice@neon.city" time="5 minutes ago" likes=34 replies=12 reposts=8]
      [text]Just shipped the component system for AML![/text]
      [text]You can now define reusable templates with [[def]].[/text]
    [/post]

    [post author="@bob@dark.zone" time="1 hour ago" likes=17 replies=5 reposts=3]
      [text]Tags are great for inline labels:[/text]
      [spacer lines=1 /]
      [tag color=cyan label="rust" /] [tag color=yellow label="art" /] [tag color=green label="bbs" /]
    [/post]
  [/section]

  [section title="Default Attribute Values"]
    [text]These badges use default color (white):[/text]
    [spacer lines=1 /]
    [badge label="DEFAULT" /]
  [/section]

  [section title="Dollar Sign Escaping"]
    [text]Component attrs use $$name syntax.[/text]
    [text]A literal dollar sign: $$USD[/text]
  [/section]

  [hr style=heavy fg=cyan /]
  [text align=center dim]End of component demos[/text]
[/page]
