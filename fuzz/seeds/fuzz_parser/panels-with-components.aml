[page mode=document title="Components + Panels"]

  [def name="accordion" attrs="id,label" slots="content"]
    [panel id=$id state="collapsed"]
      [state name="collapsed" h=1]
        [text dim]> $label[/text]
      [/state]
      [state name="expanded" h=fit transition="slide-down" duration=200ms]
        [text dim]v $label[/text]
        [slot name="content" /]
      [/state]
    [/panel]
    [button action="toggle" target=$id states="collapsed,expanded"]$label[/button]
  [/def]

  [def name="tab-button" attrs="target,to,key,label"]
    [button action="set" target=$target to=$to key=$key]$label[/button]
  [/def]

  [def name="warning-box" slots="content"]
    [box border=double fg=yellow title="WARNING"]
      [slot name="content" /]
    [/box]
  [/def]

  [def name="info-box" slots="content"]
    [box border=rounded fg=cyan title="INFO"]
      [slot name="content" /]
    [/box]
  [/def]

  [heading level=1 fg=bright-cyan]Components + Panels Combined[/heading]
  [text dim]Reusable interactive patterns built from [[def]] + [[panel]].[/text]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]FAQ Accordion[/heading]
  [text dim]Each accordion is a single component invocation.[/text]
  [spacer lines=1 /]

  [accordion id="faq-1" label="What is Dustnet?"]
    [info-box]
      [text]Dustnet is a terminal-native[/text]
      [text]network of BBS-like sites with rich ANSI art and[/text]
      [text]animated transitions.[/text]
    [/info-box]
  [/accordion]
  [spacer lines=1 /]

  [accordion id="faq-2" label="Is it safe?"]
    [info-box]
      [text]Yes. AML is not Turing-complete. There is no scripting[/text]
      [text]language, no eval, no code execution. The client is a[/text]
      [text]renderer, not an interpreter.[/text]
    [/info-box]
  [/accordion]
  [spacer lines=1 /]

  [accordion id="faq-3" label="How do I run a site?"]
    [info-box]
      [text]Run an ATP server on port 1985. Serve .aml files over[/text]
      [text]TLS. That's it. See the protocol docs for details.[/text]
    [/info-box]
  [/accordion]
  [spacer lines=1 /]

  [accordion id="faq-4" label="What about security?"]
    [warning-box]
      [text]ATP uses TLS 1.3 for transport encryption, Ed25519[/text]
      [text]for identity, and a strict no-code-execution content[/text]
      [text]model. See 05-security.md for the full threat model.[/text]
    [/warning-box]
  [/accordion]
  [spacer lines=1 /]

  [hr style=heavy /]
  [spacer lines=1 /]

  [heading level=2 fg=yellow]Reusable Tab Buttons[/heading]
  [text dim]Tab buttons defined as a component, tabs panel below.[/text]
  [spacer lines=1 /]

  [row gap=2]
    [col][tab-button target="demo-tabs" to="overview" key="1" label="1: Overview" /][/col]
    [col][tab-button target="demo-tabs" to="features" key="2" label="2: Features" /][/col]
    [col][tab-button target="demo-tabs" to="credits" key="3" label="3: Credits" /][/col]
  [/row]

  [panel id="demo-tabs" state="overview"]
    [state name="overview" transition="slide-left" duration=150ms]
      [info-box]
        [text bold]Dustnet Overview[/text]
        [spacer lines=1 /]
        [text]A federated network of terminal-native sites with[/text]
        [text]rich ANSI art, animated transitions, and portable[/text]
        [text]keypair-based identity.[/text]
      [/info-box]
    [/state]
    [state name="features" transition="slide-left" duration=150ms]
      [info-box]
        [text bold]Features[/text]
        [spacer lines=1 /]
        [list style=bullet]
          [item][text]Declarative AML content format[/text][/item]
          [item][text]Animated page transitions[/text][/item]
          [item][text]Reusable components with [[def]][/text][/item]
          [item][text]Interactive panels with state switching[/text][/item]
          [item][text]E2E encrypted direct messages[/text][/item]
        [/list]
      [/info-box]
    [/state]
    [state name="credits" transition="slide-left" duration=150ms]
      [info-box]
        [text bold]Credits[/text]
        [spacer lines=1 /]
        [text]Designed and built as a love letter to the BBS era.[/text]
        [text dim]Port 1985 -- the year FidoNet launched.[/text]
      [/info-box]
    [/state]
  [/panel]
  [spacer lines=1 /]

  [hr style=heavy fg=cyan /]
  [text align=center dim]End of combined component + panel demos[/text]
[/page]
